# Static-host headers (Cloudflare Pages / Netlify syntax).

# Hashed asset filenames — safe to cache forever. The explicit Content-Type is
# belt and braces: a stylesheet served as text/html is refused outright under
# nosniff, and that failure is invisible to curl.
/assets/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data is regenerated on every build but keeps a stable name, so revalidate.
/data/*
  Cache-Control: public, max-age=600, must-revalidate

# The service worker decides when everything else updates, so it must never be
# the stale thing: a cached sw.js pins the whole app to an old precache list.
/sw.js
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# Consent for iiest.wiki's scope_extensions claim over this origin, so Chromium
# keeps navigations here inside that installed app. The path is exact and the
# file has no extension, so the type has to be declared rather than inferred.
# GitHub Pages ignores this file entirely and picks its own type; this only
# takes effect on a host that reads _headers.
/.well-known/web-app-origin-association
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
